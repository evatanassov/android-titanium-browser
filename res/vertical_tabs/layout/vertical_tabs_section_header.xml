<!-- Section header for Pinned / tab group sections in the vertical tabs panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vertical_tabs_section_header"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vertical_tabs_section_header_height"
    android:layout_marginStart="@dimen/vertical_tabs_row_margin_horizontal"
    android:layout_marginEnd="@dimen/vertical_tabs_row_margin_horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <View
        android:id="@+id/vertical_tabs_group_color_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/vertical_tabs_group_dot"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/vertical_tabs_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Section" />

    <ImageView
        android:id="@+id/vertical_tabs_section_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_vertical_tabs_chevron"
        android:tint="?attr/colorControlNormal"
        tools:ignore="UseAppTint" />
</LinearLayout>
